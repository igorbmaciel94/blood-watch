bloodwatch.lighthousedev.uk {
	encode zstd gzip
	reverse_proxy api:8080

	log {
		output stdout
		format json
	}
}

cost.lighthousedev.uk {
	encode zstd gzip

	@api path /api/*
	reverse_proxy @api host.docker.internal:18081

	reverse_proxy host.docker.internal:18080
}

lighthousedev.uk, www.lighthousedev.uk {
	encode zstd gzip

	@habitvsPrivacy path /habitvs/privacy /habitvs/privacy/
	handle @habitvsPrivacy {
		root * /srv/static
		rewrite * /habitvs/privacy/index.html
		file_server
	}

	@habitvsSupport path /habitvs/support /habitvs/support/
	handle @habitvsSupport {
		root * /srv/static
		rewrite * /habitvs/support/index.html
		file_server
	}

	handle {
		redir https://bloodwatch.lighthousedev.uk{uri} permanent
	}

	log {
		output stdout
		format json
	}
}
